[% TRY %]
    [% PROCESS "$PLUGIN_DIR/i18n/${LANG}.inc" %]
[% CATCH %]
    [% PROCESS "$PLUGIN_DIR/i18n/default.inc" %]
[% END %]
[% WRAPPER "wrapper-staff-tool-plugin.inc" method="configure" plugin_title=T.configure_title %]
<h1>[% T.configure_title | html %]</h1>
<p>[% T.configure_notice | html %]</p>
<p><a href="/cgi-bin/koha/plugins/plugins-home.pl">[% T.back_to_plugins | html %]</a></p>
<p><a href="/cgi-bin/koha/mainpage.pl?pmk_migration=1">[% T.prepare_install | html %]</a></p>
<p><a href="/cgi-bin/koha/mainpage.pl?pmk_admin=1">[% T.open_configuration | html %]</a></p>
<p>[% T.version_label | html %] [% version | html %]</p>
[% END %]
